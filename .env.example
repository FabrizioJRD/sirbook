# ==========================================
# Variables de Entorno - Sirbook v2.0
# ==========================================

# 1. Base de datos PostgreSQL (Docker Local o Remoto)
DATABASE_URL=postgresql://sirbook:sirbook_password@localhost:5432/sirbook

# 2. Seguridad y Sesiones (JWT con persistencia de 30 días)
JWT_SECRET=sirbook_super_secret_jwt_key_2026_dev_secure

# 3. Base de datos y Auth (Supabase opcional)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# 2. Motor de IA (LLM Provider)
# Si no se define GEMINI_API_KEY, la app utiliza el generador offline inteligente (demo fallback).
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# (Opcional) LLM Local con Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:latest

# 3. Motor de Búsqueda Web (Search Provider)
# En producción: Serper.dev ($1/1k)
# SERPER_API_KEY=tu-serper-api-key

# En desarrollo local: SearXNG (Docker a costo $0)
SEARXNG_BASE_URL=http://localhost:8080

# 4. App Móvil (apps/mobile)
# URL del backend Next.js para peticiones desde Expo
EXPO_PUBLIC_API_URL=http://localhost:3000
