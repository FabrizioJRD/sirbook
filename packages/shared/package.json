{
  "name": "@sirbook/shared",
  "version": "2.0.0",
  "description": "Contratos compartidos, esquemas Zod, servicios de búsqueda e IA para Sirbook",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
